# Touchscreen gestures in tablet mode (read by ~/.local/bin/tablet-mode, run by lisgd).
# Format: fingers,direction,edge,distance,when,command
#   direction: LR RL UD DU (left->right, right->left, up->down, down->up)
#   edge:      T B L R = must start at that screen edge, * = anywhere, N = not at an edge
#   distance:  S M L = short/medium/long swipe, * = any
#   when:      R = on release
gestures=(
  # Swipe down from the top edge: tablet menu (keyboard, rotate, apps, exit)
  "1,UD,T,*,R,omarchy menu summon tablet"
  # Swipe up from the bottom edge: show / hide the on-screen keyboard
  "1,DU,B,*,R,$HOME/.local/bin/tablet-mode keyboard"
  # Swipe in from the left edge: app grid
  "1,LR,L,*,R,omarchy-shell shell toggle daa.launcher"
  # Swipe in from the right edge: close the focused window
  "1,RL,R,M,R,hyprctl dispatch 'hl.dsp.window.close()'"
  # Three-finger swipe left / right: next / previous workspace
  "3,RL,*,*,R,hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  "3,LR,*,*,R,hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
)

#!/bin/bash
# Laptop OLED brightness on a remapped scale. The panel jumps sharply between
# raw 4094 and 4095 (its full-scale value looks like a separate boost), so
# 100% here is raw 4054 and only `boost` (SHIFT + brightness up) goes to 4095.
# Steps are finer at the top, where 5% looked like a big jump:
# 100 98 96 94 92 90, then 85 80 ... 5, and 1 at the bottom.
#
#   brightness-step up|down          keys
#   brightness-step +1|-1            fine steps (ALT + keys)
#   brightness-step boost|min        SHIFT + keys
#   brightness-step set N [--no-osd] absolute N% on this scale (popup slider)
#   brightness-step get              current % on this scale (101 = boost)
#
# External monitors fall through to omarchy-brightness-display unchanged.

TOP_RAW=4054

device=$(omarchy-hw-display 2>/dev/null)
monitor=$(omarchy-hyprland-monitor-focused 2>/dev/null)

if [[ -z $device || ( -n $monitor && ! $monitor =~ ^(eDP|LVDS|DSI)- ) ]]; then
  case ${1:-} in
    up) exec omarchy-brightness-display +5% ;;
    down) exec omarchy-brightness-display 5%- ;;
    +1) exec omarchy-brightness-display +1% ;;
    -1) exec omarchy-brightness-display 1%- ;;
    boost) exec omarchy-brightness-display 100% ;;
    min) exec omarchy-brightness-display 1% ;;
    set) exec omarchy-brightness-display "${@:3}" "$2%" ;;
    get) exec omarchy-brightness-display ;;
  esac
  exit 1
fi

raw=$(brightnessctl -d "$device" get)
max=$(brightnessctl -d "$device" max)

# Current position on the scale; above TOP_RAW reads as 101 (boost).
if (( raw > TOP_RAW )); then cur=101
else cur=$(( (raw * 100 + TOP_RAW / 2) / TOP_RAW )); (( cur < 1 )) && cur=1; fi

osd=1
case ${1:-} in
  up)
    if (( cur >= 100 )); then next=$cur
    elif (( cur >= 90 )); then next=$(( (cur / 2 + 1) * 2 ))
    else next=$(( (cur / 5 + 1) * 5 )); fi
    (( next > 100 && cur <= 100 )) && next=100
    ;;
  down)
    if (( cur > 100 )); then next=100
    elif (( cur > 90 )); then next=$(( (cur - 1) / 2 * 2 )); (( next < 90 )) && next=90
    else next=$(( (cur - 1) / 5 * 5 )); fi
    (( next < 1 )) && next=1
    ;;
  +1) next=$(( cur >= 100 ? cur : cur + 1 )) ;;
  -1) next=$(( cur > 100 ? 100 : cur - 1 )); (( next < 1 )) && next=1 ;;
  boost) next=101 ;;
  min) next=1 ;;
  set)
    [[ ${2:-} =~ ^[0-9]+$ ]] || exit 1
    next=$2; (( next > 100 )) && next=100; (( next < 1 )) && next=1
    [[ ${3:-} == --no-osd ]] && osd=0
    ;;
  get) echo "$cur"; exit 0 ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

if (( next > 100 )); then target=$max
else target=$(( (next * TOP_RAW + 50) / 100 )); (( target < 1 )) && target=1; fi

brightnessctl -q -d "$device" set "$target"

if (( osd )); then
  if (( next > 100 )); then omarchy-osd -i brightness -m "Boost"
  else omarchy-osd -i brightness -p "$next"; fi
fi

#!/bin/bash
# Go menu lab card (daa.menu LabCard.qml): one JSON line of network status.
# Pings the lab box (address from the Remmina profile); when it's down, pings
# 1.1.1.1 instead so the sparkline still shows the internet connection.
# `lab-status ping` prints only the pings: the card samples those in the
# background so the sparkline already holds a minute when the menu opens.
# Set LAB_PROFILE to your own Remmina profile for the lab box.
PROFILE="${LAB_PROFILE:-$HOME/.local/share/remmina/lab.remmina}"
host=$(sed -n 's/^server=//p' "$PROFILE" | head -1)
host=${host%%:*}

ping_ms() { ping -c1 -W1 "$1" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -1; }

if [[ $1 == ping ]]; then
  lab=$(ping_ms "$host")
  inet=""
  [[ -z $lab ]] && inet=$(ping_ms 1.1.1.1)
  jq -cn --arg lab "$lab" --arg inet "$inet" '{
    lab: (if $lab == "" then null else ($lab | tonumber) end),
    inet: (if $inet == "" then null else ($inet | tonumber) end)
  }'
  exit
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
{ [[ -n $host ]] && ping_ms "$host" >"$tmp/lab"; } &
{ [[ -n $host ]] && curl -s -m 1.5 "http://$host:3080/v3/version" | jq -r '.version // empty' >"$tmp/gns3" 2>/dev/null; } &
{ tailscale status --json 2>/dev/null | jq -r '.BackendState // empty' >"$tmp/ts"; } &
{ mullvad status 2>/dev/null | head -1 >"$tmp/mv"; } &
wait

lab=$(<"$tmp/lab")
inet=""
[[ -z $lab ]] && inet=$(ping_ms 1.1.1.1)

jq -cn --arg lab "$lab" --arg inet "$inet" --arg gns3 "$(<"$tmp/gns3")" \
  --arg ts "$(<"$tmp/ts")" --arg mv "$(<"$tmp/mv")" '{
  lab: (if $lab == "" then null else ($lab | tonumber) end),
  inet: (if $inet == "" then null else ($inet | tonumber) end),
  gns3: (if $gns3 == "" then null else $gns3 end),
  tailscale: ($ts == "Running"),
  mullvad: ($mv | startswith("Connected"))
}'

{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},
  // Tablet mode menu: swipe down from the top edge, tap the tablet bar's Arch
  // button, or `omarchy menu summon tablet`. Same order as the tablet bar
  // (workspace, apps, keyboard, rotate, quick toggles), mode switch last.
  // Script: ~/.local/bin/tablet-mode
  "tablet": {"icon":"󰓶","label":"Tablet","description":"Touch mode, keyboard, rotation"},
  // Workspace switcher (tap the tablet bar's workspace number).
  "tablet.workspaces": {"icon":"󱂬","label":"Workspaces","provider":"workspaces"},
  // Tablet apps (the tablet bar's 󰀻 button: omarchy menu summon tablet.launch)
  "tablet.launch": {"icon":"󰀻","label":"Tablet apps","description":"Drawing, reading, notes"},
  "tablet.launch.draw": {"icon":"󰏬","label":"Draw (Rnote)","action":"uwsm-app -- rnote","when":"command -v rnote"},
  "tablet.launch.notes": {"icon":"󰠮","label":"Notes (Xournal++)","action":"uwsm-app -- xournalpp","when":"command -v xournalpp"},
  "tablet.launch.paint": {"icon":"󰏘","label":"Paint (Krita)","action":"uwsm-app -- krita","when":"command -v krita"},
  "tablet.launch.sketch": {"icon":"󰃣","label":"Sketch (Pinta)","action":"uwsm-app -- pinta","when":"command -v pinta"},
  "tablet.launch.pdf": {"icon":"󰈦","label":"PDFs (Papers)","action":"uwsm-app -- papers","when":"command -v papers"},
  "tablet.launch.books": {"icon":"󰂿","label":"Books (Foliate)","action":"uwsm-app -- foliate","when":"command -v foliate"},
  "tablet.launch.comics": {"icon":"󱗖","label":"Comics (Komikku)","action":"uwsm-app -- komikku","when":"command -v komikku"},
  "tablet.launch.kindle": {"icon":"󰂺","label":"Kindle","action":"omarchy-launch-webapp https://read.amazon.com/kindle-library"},
  "tablet.launch.browser": {"icon":"󰖟","label":"Browser","action":"omarchy-launch-browser"},
  "tablet.launch.files": {"icon":"󰉋","label":"Files","action":"sleep 0.3; hyprctl eval 'dropdown_show(\"files\")'"},
  "tablet.keyboard": {"icon":"󰌌","label":"On-screen keyboard","action":"~/.local/bin/tablet-mode keyboard"},
  "tablet.autorotate": {"icon":"󰑵","label":"Auto-rotate","action":"~/.local/bin/tablet-mode rotate-lock","checked":"[ ! -e ~/.local/state/tablet-mode/rotate-lock ]"},
  // Orientation picker (hold the tablet bar's rotate button); picking one
  // locks auto-rotate there.
  "tablet.orient": {"icon":"󰑵","label":"Orientation","description":"Pick a rotation and lock it"},
  "tablet.orient.0": {"icon":"󰁝","label":"Landscape","action":"~/.local/bin/tablet-mode orient 0","checked":"[ \"$(cat ~/.local/state/tablet-mode/rotation)\" = 0 ]"},
  "tablet.orient.1": {"icon":"󰁍","label":"Portrait left","action":"~/.local/bin/tablet-mode orient 1","checked":"[ \"$(cat ~/.local/state/tablet-mode/rotation)\" = 1 ]"},
  "tablet.orient.2": {"icon":"󰁅","label":"Flipped","action":"~/.local/bin/tablet-mode orient 2","checked":"[ \"$(cat ~/.local/state/tablet-mode/rotation)\" = 2 ]"},
  "tablet.orient.3": {"icon":"󰁔","label":"Portrait right","action":"~/.local/bin/tablet-mode orient 3","checked":"[ \"$(cat ~/.local/state/tablet-mode/rotation)\" = 3 ]"},
  // Quick toggles: the clock island's hover indicators as a touch menu (the
  // tablet bar's 󰂚 button: omarchy menu summon tablet.quick)
  "tablet.quick": {"icon":"","iconFont":"omarchy","label":"Quick toggles","description":"Do not disturb, night light, stay awake, recording"},
  "tablet.quick.screenshot": {"icon":"󰹑","label":"Screenshot","action":"sleep 0.5; omarchy capture screenshot fullscreen"},
  "tablet.quick.screenshot-area": {"icon":"󰆞","label":"Screenshot area","action":"sleep 0.5; omarchy capture screenshot region"},
  "tablet.quick.wallpaper": {"icon":"󰸉","label":"Wallpaper","action":"sleep 0.3; omarchy-menu toggle background"},
  "tablet.quick.dnd": {"icon":"󰂛","label":"Do not disturb","action":"omarchy toggle notification silencing","checked":"[ \"$(omarchy-shell notifications isDnd)\" = on ]"},
  "tablet.quick.nightlight": {"icon":"󰖔","label":"Night light","action":"omarchy toggle nightlight","checked":"omarchy toggle nightlight --status | grep -q '\"enabled\":true'"},
  "tablet.quick.awake": {"icon":"󰅶","label":"Stay awake","action":"omarchy toggle idle","checked":"omarchy toggle idle status | grep -q '\"enabled\":true'"},
  "tablet.quick.record": {"icon":"󰑊","label":"Screen recording","action":"pgrep -f '^gpu-screen-recorder' >/dev/null && omarchy-capture-screenrecording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord","checked":"pgrep -f '^gpu-screen-recorder' >/dev/null"},
  "tablet.quick.dictation": {"icon":"󰍬","label":"Dictation settings","action":"omarchy-voxtype-config","when":"command -v voxtype"},
  "tablet.quick.reminder": {"icon":"󰀠","label":"Reminders","action":"omarchy-reminder -i"},
  // Switches modes: "Desktop mode" while in tablet mode, "Tablet mode" on the
  // desktop (the Tablet submenu is in the desktop Go menu too).
  "tablet.desktop": {"icon":"󰍹","label":"Desktop mode","action":"~/.local/bin/tablet-mode off","when":"[ \"$(~/.local/bin/tablet-mode status)\" = on ]"},
  "tablet.mode": {"icon":"󰓶","label":"Tablet mode","action":"~/.local/bin/tablet-mode on","when":"[ \"$(~/.local/bin/tablet-mode status)\" = off ]"},
}

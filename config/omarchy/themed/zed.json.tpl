{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Omarchy",
  "author": "Generated from the current Omarchy theme",
  "themes": [
    {
      "name": "Omarchy",
      "appearance": "{{ mode }}",
      "style": {
        "background": "{{ dark_background }}",
        "surface.background": "{{ dark_background }}",
        "elevated_surface.background": "{{ lighter_background }}",
        "panel.background": "{{ dark_background }}",
        "panel.focused_border": "{{ accent }}",
        "pane.focused_border": "{{ accent }}",

        "border": "{{ darker_background }}",
        "border.variant": "{{ selection }}",
        "border.focused": "{{ accent }}",
        "border.selected": "{{ accent }}",
        "border.transparent": "#00000000",
        "border.disabled": "{{ muted }}",

        "title_bar.background": "{{ darker_background }}",
        "title_bar.inactive_background": "{{ darker_background }}",
        "toolbar.background": "{{ background }}",
        "status_bar.background": "{{ darker_background }}",
        "tab_bar.background": "{{ darker_background }}",
        "tab.active_background": "{{ background }}",
        "tab.inactive_background": "{{ darker_background }}",

        "text": "{{ foreground }}",
        "text.muted": "{{ dark_foreground }}",
        "text.placeholder": "{{ muted }}",
        "text.disabled": "{{ muted }}",
        "text.accent": "{{ accent }}",
        "icon": "{{ foreground }}",
        "icon.muted": "{{ dark_foreground }}",
        "icon.placeholder": "{{ muted }}",
        "icon.disabled": "{{ muted }}",
        "icon.accent": "{{ accent }}",

        "element.background": "{{ lighter_background }}",
        "element.hover": "{{ selection }}",
        "element.active": "{{ selection }}",
        "element.selected": "{{ selection }}",
        "element.disabled": "{{ dark_background }}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ selection }}",
        "ghost_element.active": "{{ selection }}",
        "ghost_element.selected": "{{ selection }}",
        "ghost_element.disabled": "#00000000",
        "drop_target.background": "{{ accent }}33",

        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "scrollbar.thumb.background": "{{ muted }}80",
        "scrollbar.thumb.hover_background": "{{ muted }}",
        "scrollbar.thumb.border": "#00000000",

        "editor.background": "{{ background }}",
        "editor.foreground": "{{ foreground }}",
        "editor.gutter.background": "{{ background }}",
        "editor.subheader.background": "{{ dark_background }}",
        "editor.active_line.background": "{{ lighter_background }}80",
        "editor.highlighted_line.background": "{{ lighter_background }}",
        "editor.line_number": "{{ muted }}",
        "editor.active_line_number": "{{ bright_foreground }}",
        "editor.invisible": "{{ muted }}",
        "editor.wrap_guide": "{{ selection }}",
        "editor.active_wrap_guide": "{{ muted }}",
        "editor.indent_guide": "{{ selection }}",
        "editor.indent_guide_active": "{{ muted }}",
        "editor.document_highlight.read_background": "{{ accent }}26",
        "editor.document_highlight.write_background": "{{ accent }}40",
        "search.match_background": "{{ yellow }}40",

        "terminal.background": "{{ background }}",
        "terminal.foreground": "{{ foreground }}",
        "terminal.bright_foreground": "{{ bright_foreground }}",
        "terminal.dim_foreground": "{{ dark_foreground }}",
        "terminal.ansi.black": "{{ color0 }}",
        "terminal.ansi.red": "{{ color1 }}",
        "terminal.ansi.green": "{{ color2 }}",
        "terminal.ansi.yellow": "{{ color3 }}",
        "terminal.ansi.blue": "{{ color4 }}",
        "terminal.ansi.magenta": "{{ color5 }}",
        "terminal.ansi.cyan": "{{ color6 }}",
        "terminal.ansi.white": "{{ color7 }}",
        "terminal.ansi.bright_black": "{{ color8 }}",
        "terminal.ansi.bright_red": "{{ color9 }}",
        "terminal.ansi.bright_green": "{{ color10 }}",
        "terminal.ansi.bright_yellow": "{{ color11 }}",
        "terminal.ansi.bright_blue": "{{ color12 }}",
        "terminal.ansi.bright_magenta": "{{ color13 }}",
        "terminal.ansi.bright_cyan": "{{ color14 }}",
        "terminal.ansi.bright_white": "{{ color15 }}",

        "link_text.hover": "{{ accent }}",
        "error": "{{ red }}",
        "error.background": "{{ red }}1a",
        "error.border": "{{ red }}",
        "warning": "{{ yellow }}",
        "warning.background": "{{ yellow }}1a",
        "warning.border": "{{ yellow }}",
        "info": "{{ blue }}",
        "info.background": "{{ blue }}1a",
        "info.border": "{{ blue }}",
        "success": "{{ green }}",
        "success.background": "{{ green }}1a",
        "success.border": "{{ green }}",
        "hint": "{{ dark_foreground }}",
        "hint.background": "{{ dark_foreground }}1a",
        "hint.border": "{{ dark_foreground }}",
        "created": "{{ green }}",
        "modified": "{{ yellow }}",
        "deleted": "{{ red }}",
        "conflict": "{{ orange }}",
        "hidden": "{{ muted }}",
        "ignored": "{{ muted }}",
        "renamed": "{{ blue }}",

        "players": [
          { "cursor": "{{ bright_foreground }}", "selection": "{{ selection }}", "background": "{{ accent }}" },
          { "cursor": "{{ magenta }}", "selection": "{{ magenta }}40", "background": "{{ magenta }}" },
          { "cursor": "{{ green }}", "selection": "{{ green }}40", "background": "{{ green }}" },
          { "cursor": "{{ orange }}", "selection": "{{ orange }}40", "background": "{{ orange }}" }
        ],

        "syntax": {
          "comment": { "color": "{{ dark_foreground }}", "font_style": "italic" },
          "comment.doc": { "color": "{{ dark_foreground }}", "font_style": "italic" },
          "keyword": { "color": "{{ bright_magenta }}" },
          "operator": { "color": "{{ bright_cyan }}" },
          "punctuation": { "color": "{{ light_foreground }}" },
          "punctuation.bracket": { "color": "{{ light_foreground }}" },
          "punctuation.delimiter": { "color": "{{ light_foreground }}" },
          "punctuation.special": { "color": "{{ bright_cyan }}" },
          "string": { "color": "{{ green }}" },
          "string.escape": { "color": "{{ bright_cyan }}" },
          "string.regex": { "color": "{{ bright_cyan }}" },
          "string.special": { "color": "{{ orange }}" },
          "number": { "color": "{{ bright_yellow }}" },
          "boolean": { "color": "{{ bright_yellow }}" },
          "constant": { "color": "{{ bright_yellow }}" },
          "function": { "color": "{{ blue }}" },
          "function.method": { "color": "{{ blue }}" },
          "constructor": { "color": "{{ bright_blue }}" },
          "type": { "color": "{{ bright_cyan }}" },
          "type.builtin": { "color": "{{ bright_cyan }}" },
          "variable": { "color": "{{ bright_foreground }}" },
          "variable.special": { "color": "{{ red }}" },
          "property": { "color": "{{ green }}" },
          "attribute": { "color": "{{ yellow }}" },
          "tag": { "color": "{{ red }}" },
          "label": { "color": "{{ blue }}" },
          "namespace": { "color": "{{ bright_cyan }}" },
          "title": { "color": "{{ blue }}", "font_weight": 700 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "link_text": { "color": "{{ accent }}" },
          "link_uri": { "color": "{{ bright_cyan }}" },
          "embedded": { "color": "{{ foreground }}" },
          "preproc": { "color": "{{ bright_magenta }}" },
          "enum": { "color": "{{ orange }}" },
          "variant": { "color": "{{ orange }}" }
        }
      }
    }
  ]
}
